{
  "name": "tv-do-mundo",
  "private": true,
  "version": "0.1.0",
  "description": "Globo 3D para assistir TV aberta ao vivo de qualquer lugar do mundo.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data": "tsx scripts/build-data.ts",
    "check": "tsx scripts/check-streams.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "flag-icons": "^7.6.0",
    "globe.gl": "^2.46.2",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "validate-branch-name": "^1.3.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "validate-branch-name": {
    "pattern": "^(main|develop)$|^(feature|fix|hotfix|refactor|chore|docs|ci|build)/APP-[0-9]+-[a-z0-9]+(-[a-z0-9]+)*$|^release/[0-9]+\\.[0-9]+\\.[0-9]+$",
    "errorMsg": "Nome de branch inválido. Use <tipo>/APP-<n>-<descricao-kebab> (ex.: feature/APP-14-tela-pedidos) ou release/X.Y.Z."
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/probuled/tv-do-mundo.git"
  },
  "homepage": "https://tv-do-mundo.probuled.workers.dev/"
}
