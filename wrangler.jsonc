// Configuração do deploy no Cloudflare Workers (só arquivos estáticos, sem script).
// Sem este arquivo, o `wrangler deploy` da main se configurava sozinho, mas o
// `wrangler versions upload` dos builds de branch falhava com "Missing entry-point".
{
  "name": "tv-do-mundo",
  "compatibility_date": "2026-10-23",
  "build": {
    "command": "npm run build",
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
